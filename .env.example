# Copy to `.env` and edit. Every variable is optional: the values below are the shipped defaults.
# Lists are JSON, not comma-separated: ALLOWED_HOSTS=["a.example.com","b.example.com"].

# --- HTTP server -----------------------------------------------------------------------------------
# Interface and port uvicorn binds to.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Hostnames clients use to reach this server, checked against the Host header.
# ["*"] accepts any host, which disables the check: set this before exposing the server.
ALLOWED_HOSTS=["*"]

# Browser origins allowed to call the server. [] rejects every cross-origin browser request.
ALLOWED_ORIGINS=[]

# Peers whose X-Forwarded-For header is believed (addresses, CIDR or literals).
# Behind an ingress, list its pod network; widening this lets callers forge their own address.
TRUSTED_PROXY_HOSTS=["127.0.0.1"]

# --- Elasticsearch ---------------------------------------------------------------------------------
# The two search tools read prebuilt indices; the exception is get_melodi_observations, which calls
# the Melodi REST API directly. Leaving this unset is a supported configuration: the server starts,
# and the two search tools answer with an error saying so. There is no public index to point at, so
# the index builder has to be run first (see the README).
# ES_HOST=http://localhost:9200
ES_INDEX_MELODI_DATASETS=melodi_datasets
ES_INDEX_MELODI_COLUMNS=melodi_columns

# Elasticsearch is often internal, with a self-signed certificate. Set false only for that case.
ES_TLS_VERIFY=true
ES_REQUEST_TIMEOUT_SECONDS=30
# Retries the client makes on its own before a search is reported as failed.
ES_MAX_RETRIES=2

# --- Melodi REST API -------------------------------------------------------------------------------
# Public, keyless endpoint the observations tool calls. The same one a human browses.
MELODI_DATA_BASE_URL=https://api.insee.fr/melodi/data
MELODI_REQUEST_TIMEOUT_SECONDS=30
MELODI_CONNECT_TIMEOUT_SECONDS=10
# search_melodi_modalities reads this many columns, then keeps number_of_modalities in each.
MELODI_COLUMN_SEARCH_SIZE=20

# --- Tool budgets ----------------------------------------------------------------------------------
# Published in the tool schemas, so a change is visible to the model after a restart.
# Each default must stay within its maximum, or the server refuses to start.
MELODI_DEFAULT_OBSERVATIONS=100
MELODI_MAX_OBSERVATIONS=1000
MELODI_DEFAULT_DATASETS=5
MELODI_MAX_DATASETS=20
MELODI_DEFAULT_MODALITIES=10
MELODI_MAX_MODALITIES=50

# --- Rate limiting ---------------------------------------------------------------------------------
# Requests per client address per window. Client identity comes from TRUSTED_PROXY_HOSTS.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# --- Logging ---------------------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Identity --------------------------------------------------------------------------------------
# Server name and instructions sent in the MCP handshake.
SERVER_NAME=mcpmelodi
# INSTRUCTIONS= free-text block sent with the handshake; the shipped default is the short set of
# rules in settings.py. Multi-line values are awkward in .env, so set it in code if you need more.
